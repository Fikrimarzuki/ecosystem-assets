{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecosystem-assets:catalog:v1",
  "title": "Ecosystem Assets catalog v1",
  "type": "object",
  "required": ["schemaVersion", "assets", "logicalAssets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "logicalAssets": { "type": "array", "items": { "$ref": "#/$defs/logicalAsset" } },
    "showcases": { "type": "array", "items": { "$ref": "#/$defs/showcase" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "projectId", "path", "role", "category", "format", "bytes", "sha256", "publication", "rightsStatus"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "role": { "enum": ["source", "export", "candidate", "review", "reference", "legacy"] },
        "category": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "url": { "type": "string", "pattern": "^/published/[a-f0-9]{64}\\.[a-z0-9]+$" },
        "publication": { "enum": ["private", "public"] },
        "rightsStatus": { "enum": ["unknown", "unverified", "verified", "restricted"] },
        "dimensions": { "type": "object", "required": ["width", "height"], "additionalProperties": false, "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "string" },
        "logicalAssetIds": { "type": "array", "items": { "type": "string" } },
        "relatedAssetIds": { "type": "array", "items": { "type": "string" } },
        "sourceMetadata": { "type": "object" }
      }
    },
    "publicFile": {
      "type": "object",
      "required": ["key", "url", "format", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "url": { "type": "string", "pattern": "^/published/[a-f0-9]{64}\\.[a-z0-9]+$" },
        "format": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "caption": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "dimensions": { "type": "object", "required": ["width", "height"], "additionalProperties": false, "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "showcase": {
      "type": "object",
      "required": ["id", "projectId", "slug", "title", "description", "category", "publication", "media", "downloads"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "publication": { "enum": ["showcase", "downloadable"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "logicalAssetId": { "type": "string" },
        "relatedShowcaseIds": { "type": "array", "items": { "type": "string" } },
        "media": { "type": "array", "items": { "$ref": "#/$defs/publicFile" } },
        "downloads": { "type": "array", "items": { "$ref": "#/$defs/publicFile" } }
      }
    },
    "logicalAsset": {
      "type": "object",
      "required": ["id", "projectId", "physicalAssetIds"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "physicalAssetIds": { "type": "array", "items": { "type": "string" } },
        "legacyId": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" }
      }
    }
  }
}
